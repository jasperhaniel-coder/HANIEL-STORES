# Copy this file to ".env" for local work. NEVER commit the real .env file.
# On Vercel, add these under Project -> Settings -> Environment Variables.

# From your Supabase project (Connect dialog / Settings -> API Keys)
SUPABASE_URL=
# The PUBLISHABLE key (starts with sb_publishable_). Safe for public reads.
SUPABASE_PUBLISHABLE_KEY=

# Needed from a later phase. Do NOT add these yet.
# The SECRET key (starts with sb_secret_) bypasses all security rules:
# server-side only, never in GitHub, never in browser code.
# SUPABASE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=

SITE_URL=https://haniel-stores-ecommerce.vercel.app
